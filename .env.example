# Lagom – miljövariabler. Steg för steg: docs/BETALNING.md
#
# Lokalt: kopiera till .env.local (ignoreras av git) och fyll i. Checka ALDRIG in riktiga nycklar.
# På Netlify: Site configuration → Environment variables. Använd testnycklar för förhandsversioner
# och skarpa nycklar bara för Production ("Different value for each deploy context").

# ---------------------------------------------------------------------------
# Byggs in i appen vid bygget (syns för alla – inga hemligheter här).
# Ändrar du något av dessa måste appen byggas om.
# ---------------------------------------------------------------------------

# 'live' = riktiga köp via Stripe. Allt annat (eller tomt) = testläge där köpknappen ger en testlicens.
VITE_COMMERCE_MODE=test
# Publik nyckel för licenser (SPKI, base64) från: node scripts/generate-license-keys.mjs
VITE_LICENSE_PUBLIC_KEY=
# Visas i appen vid köp och i felmeddelanden.
VITE_SUPPORT_EMAIL=support@example.se
# Säljarens namn (krävs enligt distansavtalslagen), t.ex. "Lagom AB" eller ditt namn för enskild firma.
VITE_SELLER_NAME=
# Bara om serverfunktionerna ligger på en annan adress än appen, t.ex. https://lagom.netlify.app
VITE_API_BASE=

# ---------------------------------------------------------------------------
# Bara serverfunktionerna (netlify/functions). HEMLIGA – markera som hemliga i Netlify.
# ---------------------------------------------------------------------------

# Stripes hemliga nyckel. Helst en begränsad nyckel (rk_…) med: Checkout Sessions: Write,
# Prices: Read, PaymentIntents: Write. Testnyckel: sk_test_…/rk_test_…
STRIPE_SECRET_KEY=
# Pris-id för Årslicens (299 kr) och Livstidslicens (599 kr), inkl. moms, engångspris.
# Flera id:n kan anges med kommatecken: det första används för nya köp, äldre godtas fortfarande.
# Tomt = priset skickas från koden (bra för ett snabbt test).
STRIPE_PRICE_AR=
STRIPE_PRICE_LIVSTID=
# Privat nyckel för licenser (PKCS#8, base64) från: node scripts/generate-license-keys.mjs
LICENSE_PRIVATE_KEY=
# Appens adress, dit kunden skickas efter betalningen (utan avslutande /).
# Tomt = webbplatsens adress på Netlify.
APP_URL=http://localhost:8888
# Fler adresser (kommaseparerade) som får anropa funktionerna, t.ex. en egen domän.
ALLOWED_ORIGINS=

# Valfritt: webhook från Stripe (whsec_…), se docs/BETALNING.md.
STRIPE_WEBHOOK_SECRET=
# Valfritt: köpvillkor. Då måste kunden även i Stripe Checkout kryssa i att hen godkänner villkoren
# och att ångerrätten upphör vid leverans. Kräver "Terms of service URL" i Stripe (Settings → Public details).
TERMS_URL=
# Valfritt: on = Stripe Tax räknar ut och specificerar momsen (kräver Stripe Tax).
STRIPE_AUTOMATIC_TAX=
