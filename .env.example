# Lagom – miljövariabler. Steg för steg: docs/BETALNING.md
#
# Lokalt: kopiera till .env.local (ignoreras av git) och fyll i. Checka ALDRIG in riktiga nycklar.
# På Netlify: Site configuration → Environment variables. Använd testnycklar för förhandsversioner
# och skarpa nycklar bara för Production ("Different value for each deploy context").
# Värden som slutar på example.invalid är platshållare – de kan aldrig ta emot post.

# ---------------------------------------------------------------------------
# Byggs in i appen vid bygget (syns för alla – inga hemligheter här).
# Ändrar du något av dessa måste appen byggas om.
# ---------------------------------------------------------------------------

# Vilket bygge: web (webbversionen, standard), appstore (iPhone-appen) eller play (Google Play).
# Stripe används bara i webbversionen – i butiksapparna görs köpet i App Store eller Google Play.
VITE_DISTRIBUTION=web
# 'live' = riktiga köp via Stripe. Allt annat (eller tomt) = testläge där köpknappen ger en testlicens.
# Med 'live' stoppas bygget om den publika licensnyckeln saknas eller är ogiltig (annars blev det testläge).
VITE_COMMERCE_MODE=test
# Publik nyckel för licenser (SPKI, base64) från: node scripts/generate-license-keys.mjs
VITE_LICENSE_PUBLIC_KEY=
# Valfritt vid nyckelbyte: flera publika nycklar, kommaseparerade, den nuvarande först. Är den satt
# används den i stället för VITE_LICENSE_PUBLIC_KEY – ta då med den gamla nyckeln i listan, så att
# sålda licenser fortsätter att gälla.
VITE_LICENSE_PUBLIC_KEYS=
# Bara om serverfunktionerna ligger på en annan adress än appen, t.ex. https://lagom.netlify.app.
# Krävs i butiksbyggena (appstore/play).
VITE_API_BASE=
# Valfritt: off = inga köp på webben (Lagom säljs då bara i appbutikerna). Tomt = på.
VITE_WEB_SALES=
# Valfritt: länkar till Lagom i App Store och Google Play (visas när webbförsäljningen är av).
VITE_APPSTORE_URL=
VITE_PLAY_URL=
# Adressen till de fullständiga köpvillkoren, t.ex. https://<din domän>/villkor/ (skarpt läge
# varnar när den saknas – sätt samma adress i TERMS_URL nedan).
VITE_TERMS_URL=

# Säljarens uppgifter (distansavtalslagen). Visas i appen och på fakturan från Stripe, så ge dem
# scope "Builds" OCH "Functions" i Netlify. Skarpa byggen, butiksbyggen och skarpa köp stoppas tills
# namn, adress, telefon och e-post är ifyllda. För enskild firma: ditt namn eller firmanamnet.
VITE_SELLER_NAME=
# Frivilligt: organisationsnumret – för enskild firma ditt personnummer, som då syns i appen och på
# varje faktura. Fråga Verksamt eller en jurist om det måste visas (se docs/BETALNING.md).
VITE_SELLER_ORGNR=
VITE_SELLER_ADDRESS=
VITE_SELLER_PHONE=
# Momsregistreringsnummer – bara om firman är momsregistrerad (en momsbefriad firma har inget).
VITE_SELLER_VAT=
# E-post för frågor om köp. Visas vid köp, i felmeddelanden och på fakturan.
VITE_SUPPORT_EMAIL=support@example.invalid

# Lagom Moln (synkning) är avstängt i version 1.0 – lämna tomma. Ingen egen databas används.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Bara vid bygget på Netlify (inte i appen).
# ---------------------------------------------------------------------------

# 1 = ett produktionsbygge i testläge (utan riktiga köp) är avsiktligt. Utan den stoppas ett
# produktionsbygge som inte har VITE_COMMERCE_MODE=live. Ta bort den innan du börjar sälja.
# Ge den också scope "Functions": då godtar servern testköp i produktionen före lanseringen.
LAGOM_ALLOW_TEST_COMMERCE=

# Sätts bara för förhandsversioner och grenbyggen (redan i netlify.toml): appen godtar licenser
# från köp med Stripes testkort även i skarpt läge. ALDRIG för Production – bygget stoppas då.
# VITE_ACCEPT_TEST_PURCHASES=

# Ägarens privata webbversion (GitHub Pages sätter den i .github/workflows/pages.yml): 1 = full åtkomst,
# ingen provperiod eller köpspärr. Byggkontrollen stoppar den i butiksbyggen och Netlifys produktionsbygge.
# VITE_OWNER_ONLY=

# Bara för testbyggen av butiksapparna på din egen dator (simulator, skärmdumpar): 1 = bygg fast
# köp i appen inte är inkopplade. Ett sådant bygge får aldrig skickas in.
# LAGOM_ALLOW_STORE_WITHOUT_IAP=

# ---------------------------------------------------------------------------
# Bara serverfunktionerna (netlify/functions). HEMLIGA – markera som hemliga i Netlify.
# ---------------------------------------------------------------------------

# Stripes hemliga nyckel. Helst en begränsad nyckel (rk_…), se docs/BETALNING.md steg 6 för
# behörigheterna. Testnyckel: sk_test_…/rk_test_…
STRIPE_SECRET_KEY=
# Pris-id för Årslicens (349 kr) och Livstidslicens (699 kr), inkl. moms, engångspris.
# Flera id:n kan anges med kommatecken: det första används för nya köp, äldre godtas fortfarande.
# Tomt = priset skickas från koden (bra för ett snabbt test).
STRIPE_PRICE_AR=
STRIPE_PRICE_LIVSTID=
# Privat nyckel för licenser (PKCS#8, base64) från: node scripts/generate-license-keys.mjs
LICENSE_PRIVATE_KEY=
# Appens adress, dit kunden skickas efter betalningen (utan avslutande /).
# Tomt = webbplatsens adress på Netlify.
APP_URL=http://localhost:8888
# Fler adresser (kommaseparerade) som får anropa funktionerna, t.ex. en egen domän.
ALLOWED_ORIGINS=
# Ursprung för iPhone-appen (Capacitor). Tomt = capacitor://localhost,https://localhost.
# off = inga. Bara exakt capacitor://localhost och https://localhost godtas.
ALLOWED_NATIVE_ORIGINS=

# Valfritt: webhook från Stripe (whsec_…), se docs/BETALNING.md.
STRIPE_WEBHOOK_SECRET=
# Valfritt: köpvillkor. Då måste kunden även i Stripe Checkout kryssa i att hen godkänner villkoren
# och att ångerrätten upphör vid leverans. Kräver "Terms of service URL" i Stripe (Settings → Public details).
TERMS_URL=
# Köpvillkorens version, sparas på varje köp och står på fakturan. Tomt = 2026-10-01.
# Ändra den när du publicerar nya köpvillkor.
TERMS_VERSION=
# Valfritt: on = Stripe Tax räknar ut och specificerar momsen (kräver Stripe Tax).
STRIPE_AUTOMATIC_TAX=
# Valfritt: licenser som ska spärras utan återbetalning (kommaseparerade köp-id, t.ex. lic_… eller
# cs_live_…, eller nyckelhashar). De läggs till i spärrlistan.
LICENSE_REVOKED_IDS=
