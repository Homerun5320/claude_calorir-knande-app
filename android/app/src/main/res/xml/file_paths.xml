<?xml version="1.0" encoding="utf-8"?>
<!--
  Mappen som andra appar kan få läsa en enskild fil ur via FileProvider, när en export eller
  säkerhetskopia delas (Capacitor Share). Bara exportmappen i cachen (src/native/files.ts skriver
  till Directory.Cache/delning/) – aldrig appens filmapp, där den automatiska kopian av dagboken
  (lagom-spegling.json) ligger.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="delning" path="delning/" />
</paths>
