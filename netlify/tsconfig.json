{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.netlify.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    /* Testerna importerar skripten i scripts/*.mjs (typerna härleds, JS kontrolleras inte) */
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode (Netlify paketerar funktionerna med esbuild) */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["functions", "lib", "tests"]
}
